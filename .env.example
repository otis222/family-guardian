# 複製成 .env 再填值；.env 已列在 .gitignore，不會進版控。
# 程式只讀取變數名稱對應的值，不會把值印出來。

# 模型 API 金鑰（live 模式才需要）
GROQ_API_KEY=

# 發送者 ID 雜湊用的鹽：請換成一串只有你知道的隨機字元
GUARDIAN_HASH_SALT=

# 覆蓋 config.yaml 的 llm.mode（offline｜replay｜live），留空就用設定檔
GUARDIAN_LLM_MODE=

# LINE 伺服器才需要。真實訊息只能用 live（或測試用的 offline），不能用 replay（SPEC 第 8 節）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 守護人的 LINE 使用者編號（U 開頭，逗號分隔）。自己的在 LINE Developers 的 Basic settings；
# 其他守護人私訊官方帳號，會收到自己的編號
GUARDIAN_LINE_USER_IDS=
# 允許處理的群組（C 開頭，逗號分隔）。機器人被加進新群組時，編號會印在伺服器畫面上；不在這裡的群組一律不處理
GUARDIAN_GROUP_IDS=
# 固定的公開網址（用具名通道時才要填）。留空就自動偵測 cloudflared 的 Quick Tunnel
PUBLIC_BASE_URL=
